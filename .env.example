# ── Anthropic Claude API ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-여기에_API_키_입력

# ── SMTP 이메일 설정 ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_RECIPIENTS=scm-team@hansol.com,logistics@hansol.com
REVIEWER_EMAILS=reviewer@hansol.com

# ── IMAP 설정 (검수 메일 회신 감지용) ────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# ── Fernet 암호화 키 (Streamlit Cloud 배포 시 필수) ──────────
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 위 명령으로 키를 생성하여 Streamlit Cloud secrets에 등록
FERNET_KEY=

# ── 스케줄러 설정 ─────────────────────────────────────────────
POLL_START_HOUR=15
POLL_END_HOUR=17
POLL_INTERVAL_MIN=5

# ── ksg.co.kr 로그인 (SCFI 이력 데이터용, 선택사항) ───────────
KSG_USERNAME=
KSG_PASSWORD=

# ── 개발/테스트 모드 ──────────────────────────────────────────
# true 로 설정 시 실제 스크래핑 대신 샘플 데이터 사용
DEMO_MODE=false
